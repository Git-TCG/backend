# GitHub OAuth App callback URLs: http://localhost:8123/api/auth/github, http://192.168.0.33:8123/api/auth/github, https://git-tcg.shxin.kr/api/auth/github
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
# App token with public_repo access. Keep private; never commit your real .env.
GITHUB_CLASSIC_TOKEN=replace-me
OPENAI_API_KEY=replace-me
CORS_ORIGINS=localhost,192.168.0.33,https://git-tcg.shxin.kr
# Comma-separated GitHub numeric user IDs granted admin rights. Empty by default.
ADMIN_GITHUB_IDS=
POSTGRES_PASSWORD=replace-me
PUBLIC_URL=http://localhost:8123
